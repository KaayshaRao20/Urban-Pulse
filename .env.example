# =============================================================================
# URBANPULSE SMART CITY PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# --- 1. FRONTEND ENVIRONMENT (Set in Vercel Project Settings) ---
# Project URL & Anon Key from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API URL (Points to your deployed FastAPI backend on Render / Railway)
# During local development, defaults to http://localhost:8000/api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# --- 2. BACKEND ENVIRONMENT (Set in Render / Railway / Backend Host) ---
# Supabase PostgreSQL Database URI (Project Settings -> Database -> Connection String URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase API & Service Role Secrets
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
JWT_SECRET=your-supabase-jwt-secret-or-custom-secret

PORT=8000
